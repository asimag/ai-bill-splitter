# Backend API
PORT=8787
# PostgreSQL connection string used by the API and migrations
DATABASE_URL=postgres://asim@localhost:5433/billsplit_dev
# Secret used to sign organizer session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# "true" when serving over HTTPS (enables secure cookies)
PROD=false

# Web (Vite dev server proxies /api to this URL)
VITE_API_URL=http://localhost:8787

# Stage 3 — receipt capture and AI extraction.
# Mode: auto (local first, Gemini fallback) | local (never cloud) | gemini | tesseract
RECEIPT_AI_MODE=auto
# Local OpenAI-compatible vision server, reachable FROM THE BACKEND/CONTAINER.
# Inside Docker, localhost means the container itself — use a host-reachable address.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
# Gemini Flash fallback. Model ID is configuration, not code (verified stable +
# image-capable at implementation time; gemini-3.8-flash as of 2026-11-03).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Bounded per-attempt timeout for both providers.
RECEIPT_AI_TIMEOUT_MS=30000
# Encrypts organizer API keys saved in settings (separate from SESSION_SECRET).
# Generate: openssl rand -hex 32  — losing this invalidates saved keys.
CREDENTIALS_SECRET=change-me
# Private receipt storage dir (default: <repo>/receipts-storage; mount a volume in Docker).
# RECEIPT_STORAGE_DIR=
# RECEIPT_MAX_BYTES=10485760
# NOTE: the nginx container sets client_max_body_size 12m for /api so 10 MB
# uploads survive the proxy; raise it together with RECEIPT_MAX_BYTES if raised.

# Access control. "false" closes registration (deployments default to false in
# docker-compose.yml): open it briefly to create organizer accounts, then close
# it, so strangers cannot consume the server's receipt-AI quota.
ALLOW_REGISTRATION=true
# In-process sliding limits (per 15-min or 1-hour window, see src/rate-limit.ts):
# RATE_LIMIT_WINDOW_MS=900000         # login + AI-test window
# RATE_LIMIT_LOGIN_MAX=20             # login attempts per IP per window
# RATE_LIMIT_REGISTER_MAX=5           # registrations per IP per hour
# RATE_LIMIT_UPLOAD_MAX=30            # receipt uploads+retries per organizer per hour
# RATE_LIMIT_AI_TEST_MAX=10           # connection tests per organizer per window
